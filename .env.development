# 开发环境配置
NODE_ENV=development
# app名称
APP_NAME="NestJS API 测试环境"

# ========== 日志配置 ==========
# 日志等级（开发环境最详细）
LOG_LEVEL=trace
# 日志格式（美化输出）
LOG_PRETTY=true
# 是否输出到文件（开发环境不输出，仅终端）
LOG_FILE_ENABLED=false
# 单个日志文件最大大小（MB）
LOG_MAX_SIZE_MB=10

# 数据库地址
DATABASE_HOST=localhost
# 数据库端口
DATABASE_PORT=3306
# 数据库登录名
DATABASE_USERNAME=root
# 数据库登录密码
DATABASE_PASSWORD=123
# 数据库名字
DATABASE_NAME=tw_nestjs
# 根据实体自动创建数据库表，生产环境建议关闭
DATABASE_SYNCHRONIZE=true
# 最大链接数
DATABASE_MAX_CONNECTIONS=100

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=123

