# 生产环境配置
NODE_ENV=production
# app名称
APP_NAME="NestJS API 生产环境"

# ========== 日志配置 ==========
# 日志等级（生产环境只记录重要日志）
LOG_LEVEL=info
# 日志格式（生产环境输出 JSON）
LOG_PRETTY=false
# 是否输出到文件
LOG_FILE_ENABLED=true
# 日志轮转策略（按大小轮转）
LOG_ROTATION_STRATEGY=size
# 单个日志文件最大大小（MB）
LOG_MAX_SIZE_MB=10
# 日志保留时间
LOG_KEEP=30d

# 数据库地址
DATABASE_HOST=localhost
# 数据库端口
DATABASE_PORT=3306
# 数据库登录名
DATABASE_USERNAME=root
# 数据库登录密码
DATABASE_PASSWORD=123
# 数据库名字
DATABASE_NAME=tw_nestjs
# 根据实体自动创建数据库表，生产环境建议关闭
DATABASE_SYNCHRONIZE=false
# 最大链接数
DATABASE_MAX_CONNECTIONS=100

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=123